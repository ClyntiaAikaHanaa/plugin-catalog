{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ClyntiaAikaHanaa.github.io/plugin-catalog/catalog.schema.json",
  "title": "Studio Hub catalog",
  "type": "object",
  "required": ["schema_version", "generated_at", "plugins"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "catalog_ttl_seconds": {
      "type": "integer",
      "minimum": 300,
      "maximum": 604800,
      "default": 21600
    },
    "launcher": { "$ref": "#/$defs/launcher" },
    "daw_processes": {
      "type": "array",
      "items": { "$ref": "#/$defs/daw_process" }
    },
    "categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/category" }
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-.]+)?$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latest_version": { "$ref": "#/$defs/semver" },
        "manifest_url": { "$ref": "#/$defs/https_url" },
        "minimum_supported_version": { "$ref": "#/$defs/semver" }
      }
    },
    "daw_process": {
      "type": "object",
      "required": ["name", "executables"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "executables": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "category": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,32}$" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "target",
        "format",
        "url",
        "size_bytes",
        "sha256",
        "archive_root",
        "install_kind"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "enum": ["windows-x86_64", "macos-universal", "linux-x86_64"]
        },
        "format": { "enum": ["vst3", "clap"] },
        "url": {
          "oneOf": [{ "$ref": "#/$defs/https_url" }, { "type": "null" }]
        },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "archive_root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\:]+$"
        },
        "install_kind": { "enum": ["vst3_bundle", "clap_file"] },
        "requires_vc_redist": { "type": "boolean", "default": false }
      }
    },
    "release": {
      "type": "object",
      "required": ["version", "builds"],
      "additionalProperties": false,
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "released_at": { "type": "string", "format": "date-time" },
        "breaking": { "type": "boolean", "default": false },
        "security": { "type": "boolean", "default": false },
        "min_launcher_version": { "$ref": "#/$defs/semver" },
        "changelog": { "type": "string", "maxLength": 20000 },
        "builds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/build" }
        }
      }
    },
    "commercial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "enum": ["free", "paid", "freemium"] },
        "requires_license": { "type": "boolean" },
        "purchase_url": {
          "oneOf": [{ "$ref": "#/$defs/https_url" }, { "type": "null" }]
        }
      }
    },
    "user_data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset_paths": { "type": "array", "items": { "type": "string" } },
        "config_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os_min_build": { "type": "integer", "minimum": 0 },
        "cpu_features": { "type": "array", "items": { "type": "string" } },
        "disk_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "plugin": {
      "type": "object",
      "required": ["id", "name", "vendor", "category", "tagline", "latest"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,31}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "vendor": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "type": "string", "pattern": "^[a-z0-9-]{2,32}$" },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 20000 },
        "readme": { "type": "string", "maxLength": 80000 },
        "icon_url": { "$ref": "#/$defs/https_url" },
        "screenshots": {
          "type": "array",
          "items": { "$ref": "#/$defs/https_url" }
        },
        "homepage_url": { "$ref": "#/$defs/https_url" },
        "source_url": { "$ref": "#/$defs/https_url" },
        "license": { "type": "string" },
        "hidden": { "type": "boolean", "default": false },
        "deprecated": { "type": "boolean", "default": false },
        "deprecation_notice": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        },
        "commercial": { "$ref": "#/$defs/commercial" },
        "latest": { "$ref": "#/$defs/release" },
        "history": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/release" }
        },
        "user_data": { "$ref": "#/$defs/user_data" },
        "requirements": { "$ref": "#/$defs/requirements" }
      }
    }
  }
}
